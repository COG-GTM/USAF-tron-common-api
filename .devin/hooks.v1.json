{
  "SessionStart": [
    {
      "hooks": [
        { "type": "command", "command": "python3 \"$DEVIN_PROJECT_DIR/demo-kit/hooks/agent_audit.py\" session-start", "timeout": 5 }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^(exec|read|mcp__.*)$",
      "hooks": [
        { "type": "command", "command": "python3 \"$DEVIN_PROJECT_DIR/demo-kit/hooks/guard.py\"", "timeout": 5 }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "",
      "hooks": [
        { "type": "command", "command": "python3 \"$DEVIN_PROJECT_DIR/demo-kit/hooks/agent_audit.py\" tool", "timeout": 5 }
      ]
    }
  ]
}
